{
  "name": "thebob",
  "version": "0.1.0",
  "private": true,
  "description": "TheBob, ranking mensal do Abramark e selo de prova social para quem vende serviço em marketing digital",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @thebob/web dev",
    "build": "pnpm --recursive --filter './apps/*' --filter './packages/*' build",
    "build:web": "pnpm --filter @thebob/web build",
    "build:pipeline": "pnpm --filter @thebob/pipeline build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:diff": "supabase db diff",
    "supabase:push": "supabase db push --linked"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "supabase": "^2.5.0"
  },
  "packageManager": "pnpm@9.12.0"
}
