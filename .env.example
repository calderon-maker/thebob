# =====================================================
# TheBob, variáveis de ambiente
# Copiar para .env.local (dev) ou .env.production (VPS)
# Nunca commitar valores reais
# =====================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=https://thebestof.com.br
NEXT_PUBLIC_BOB_URL=https://thebob.com.br
NODE_ENV=development

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Stripe Brasil ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MEMBER_MONTHLY=
STRIPE_PRICE_MEMBER_YEARLY=
STRIPE_PRICE_ASPIRING_MONTHLY=

# --- Email transacional (Resend) ---
RESEND_API_KEY=
